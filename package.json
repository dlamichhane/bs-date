  },
  "homepage": "https://github.com/lamichhanedeepak/bs-date",
  "bugs": {
    "url": "https://github.com/lamichhanedeepak/bs-date/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "julian": "^0.2.0"
  }
